{
	"name": "@8gent/proxy",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "OpenAI-compatible localhost gateway over the 8gent adaptive router. Local-first routing across local + cloud providers.",
	"bin": {
		"8gent-proxy": "src/index.ts"
	},
	"main": "src/index.ts",
	"scripts": {
		"start": "bun run src/index.ts",
		"dev": "bun run src/index.ts",
		"test": "bun test src/",
		"compile": "bash scripts/compile.sh",
		"compile:darwin-arm64": "bun build src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/8gent-proxy-darwin-arm64",
		"compile:darwin-x64": "bun build src/index.ts --compile --target=bun-darwin-x64 --outfile dist/8gent-proxy-darwin-x64",
		"compile:linux-x64": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile dist/8gent-proxy-linux-x64",
		"compile:linux-arm64": "bun build src/index.ts --compile --target=bun-linux-arm64 --outfile dist/8gent-proxy-linux-arm64",
		"compile:win-x64": "bun build src/index.ts --compile --target=bun-windows-x64 --outfile dist/8gent-proxy-win-x64.exe"
	},
	"license": "Apache-2.0"
}
