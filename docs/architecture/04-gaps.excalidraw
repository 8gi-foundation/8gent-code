   "text": "G01 Android/Termux daemon unverified (#4852)",
   "originalText": "G01 Android/Termux daemon unverified (#4852)",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 15
  },
  {
   "id": "box_g_G01_b",
   "type": "text",
   "x": 30,
   "y": 101.25,
   "width": 580,
   "height": 65,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "g_g_G01"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 79619129,
   "version": 1,
   "versionNonce": 1317106530,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1760000000018,
   "link": null,
   "locked": false,
   "text": "service.ts refuses every platform except darwin, linux, win32, so a Termux user\ncan only run `8gent daemon run` by hand. The Termux smoke job checks install,\n--version, TUI first frame and install.sh, never the daemon.\nEvidence: packages/daemon/service.ts:450-455 ; scripts/smoke-termux.sh",
   "originalText": "service.ts refuses every platform except darwin, linux, win32, so a Termux user\ncan only run `8gent daemon run` by hand. The Termux smoke job checks install,\n--version, TUI first frame and install.sh, never the daemon.\nEvidence: packages/daemon/service.ts:450-455 ; scripts/smoke-termux.sh",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 12
  },
