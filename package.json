{
  "name": "@8gi-foundation/8gent-code",
  "version": "0.20.7",
  "private": false,
  "engines": {
    "node": ">=22.5"
  },
  "description": "Autonomous coding agent. Runs locally on Ollama. Zero API cost. Your code stays on your machine. Open source.",
  "type": "module",
  "bin": {
    "8": "./bin/8gent-run.js",
    "8gent": "./bin/8gent-run.js",
    "8gent-code": "./bin/8gent-run.js"
  },
  "files": [
    "dist/cli.js",
    "dist/tui.js",
    "dist/pty-bridge.cjs",
		"dist/node/cli.js",
		"dist/node/tui.js",
		"dist/node/pty-bridge.cjs",
    "dist/skills",
    "dist/sounds",
    "bin/8gent-run.js",
    "bin/node-version.js",
    "packages/decide/calibration",
    "packages/daemon/VESSEL-CONTEXT.md",
    "bin/bunfig.empty.toml",
    "scripts/postinstall.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun --config=bin/bunfig.empty.toml run packages/eight/index.ts",
    "agent": "bun --config=bin/bunfig.empty.toml run packages/eight/index.ts",
    "daemon": "bun --config=bin/bunfig.empty.toml run packages/daemon/index.ts",
    "daemon:local": "bun --config=bin/bunfig.empty.toml run packages/daemon/scripts/start-local.ts",
    "tui": "bun --config=bin/bunfig.empty.toml run apps/tui/src/index.tsx",
    "pet": "bash apps/lil-eight/build.sh && open 'apps/lil-eight/build/Lil Eight.app'",
    "pet:build": "bash apps/lil-eight/build.sh",
    "pet:open": "open 'apps/lil-eight/build/Lil Eight.app'",
    "pet:kill": "pkill -f LilEight",
    "pet:log": "tail -f ~/.8gent/lil-eight.log",
    "install-wizard": "bun --config=bin/bunfig.empty.toml run scripts/install-wizard.tsx",
    "install:apple-foundation": "bun --config=bin/bunfig.empty.toml run scripts/install-apple-foundation.ts",
    "build:eyes-bridge": "bash packages/eyes/native/build.sh",
    "cli": "bun --config=bin/bunfig.empty.toml run bin/8gent.ts",
    "dev": "next dev",
    "build": "bun --config=bin/bunfig.empty.toml scripts/build-bundles.ts && bun --config=bin/bunfig.empty.toml scripts/build-node.ts && node scripts/build-finalize.js",
    "build:tui": "bun --config=bin/bunfig.empty.toml scripts/build-bundles.ts --tui && node scripts/build-finalize.js",
    "build:binaries": "bun --config=bin/bunfig.empty.toml run scripts/build-binaries.ts",
    "build:binaries:host": "bun --config=bin/bunfig.empty.toml run scripts/build-binaries.ts --host",
    "package:linux": "bash scripts/package-linux.sh",
    "package:windows": "pwsh scripts/package-windows.ps1",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.js",
    "preflight:native": "sh scripts/preflight-native-deps.sh",
    "test": "bun test packages/ apps/ tests/preload-temp-dirs.test.ts",
    "test:benchmarks": "bun test benchmarks/",
    "test:security": "bun test tests/security",
    "test:models": "bun --config=bin/bunfig.empty.toml scripts/test-models.ts",
    "test:models:providers": "bun --config=bin/bunfig.empty.toml scripts/test-models.ts --providers",
    "cua:setup": "bun --config=bin/bunfig.empty.toml run packages/eight/scripts/cua-setup.ts",
    "cua:run": "bun --config=bin/bunfig.empty.toml run packages/eight/scripts/cua-run.ts",
    "smoke": "bun --config=bin/bunfig.empty.toml scripts/smoke.ts",
    "smoke:fast": "bun --config=bin/bunfig.empty.toml scripts/smoke.ts --skip-network",
    "smoke:strict": "bun --config=bin/bunfig.empty.toml scripts/smoke.ts --strict",
    "smoke:pack": "bun --config=bin/bunfig.empty.toml scripts/pack-smoke.ts",
    "smoke:bare-install": "sh scripts/bare-install-smoke.sh",
    "verify:presets": "bun --config=bin/bunfig.empty.toml scripts/verify-presets.ts",
    "verify:presets:strict": "bun --config=bin/bunfig.empty.toml scripts/verify-presets.ts --strict",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:biome": "biome check .",
    "check:biome:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:tui": "tsc --noEmit -p apps/tui/tsconfig.json",
    "check:harness": "tsc --noEmit -p tsconfig.harness.json",
    "benchmark": "bun --config=bin/bunfig.empty.toml run scripts/benchmark.ts",
    "benchmark:suite": "bun --config=bin/bunfig.empty.toml run benchmarks/runner.ts",
    "benchmark:category": "bun --config=bin/bunfig.empty.toml run benchmarks/runner.ts --category",
    "benchmark:single": "bun --config=bin/bunfig.empty.toml run benchmarks/runner.ts --bench",
    "benchmark:swebench": "bun --config=bin/bunfig.empty.toml run benchmarks/swebench/run.ts",
    "benchmark:v2": "bun --config=bin/bunfig.empty.toml run benchmarks/autoresearch/harness-v2.ts",
    "benchmark:gate": "bun --config=bin/bunfig.empty.toml run benchmarks/gate.ts",
    "benchmark:gate:update": "bun --config=bin/bunfig.empty.toml run benchmarks/gate.ts --update",
    "benchmark:loop": "bun --config=bin/bunfig.empty.toml run benchmarks/computer-use-bakeoff.ts",
    "benchmark:bakeoff": "bun --no-env-file --config=bin/bunfig.empty.toml run benchmarks/computer-use-bakeoff.ts",
    "benchmark:multi": "bun --no-env-file --config=bin/bunfig.empty.toml run benchmarks/autoresearch/multi-model-harness.ts",
    "audit": "bun --no-env-file --config=bin/bunfig.empty.toml run packages/audit/cli.ts",
    "demo": "bun --no-env-file --config=bin/bunfig.empty.toml run scripts/demo-savings.ts",
    "provision-tenant": "bun --no-env-file --config=bin/bunfig.empty.toml run scripts/provision-tenant.ts",
    "harness": "bun --no-env-file --config=bin/bunfig.empty.toml run packages/harness-cli/index.ts",
    "harness:run": "bun --no-env-file --config=bin/bunfig.empty.toml run packages/harness-cli/index.ts run",
    "harness:sessions": "bun --no-env-file --config=bin/bunfig.empty.toml run packages/harness-cli/index.ts sessions",
    "harness:inspect": "bun --no-env-file --config=bin/bunfig.empty.toml run packages/harness-cli/index.ts inspect",
    "harness:doctor": "bun --no-env-file --config=bin/bunfig.empty.toml run packages/harness-cli/index.ts doctor",
    "debug": "bun --no-env-file --config=bin/bunfig.empty.toml run bin/debug.ts",
    "preflight:parse": "node scripts/excluded-parse-check.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^1.5.0",
    "@changesets/cli": "^2.30.0",
    "@napi-rs/canvas": "^0.1.97",
    "@types/bun": "latest",
    "@types/jsdom": "^28.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "bmad-method": "^6.1.0",
    "react-doctor": "^0.1.4",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@mozilla/readability": "^0.6.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.14",
    "ai": "^6.0.116",
    "cheerio": "^1.2.0",
    "glob": "^13.0.6",
    "ink": "^6.8.0",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^4.0.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "jsdom": "^28.1.0",
    "mermaid": "^11.16.1",
    "miniflare": "^4.20260317.1",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "string-width": "^8.1.1",
    "stripe": "^17.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.8.0",
    "node-pty": "^1.1.0",
    "tree-sitter": "^0.21.0",
    "tree-sitter-go": "^0.21.0",
    "tree-sitter-javascript": "^0.21.0",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-rust": "^0.21.0",
    "tree-sitter-typescript": "^0.21.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "8GI Foundation",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/8gi-foundation/8gent-code.git"
  },
  "homepage": "https://8gent.dev",
  "bugs": {
    "url": "https://github.com/8gi-foundation/8gent-code/issues"
  }
}
